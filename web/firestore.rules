rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isPositiveWholeNumber(val) {
      return val is number && val > 0 && (val is int || int(val) == val);
    }

    function isNonNegativeWholeNumber(val) {
      return val is number && val >= 0 && (val is int || int(val) == val);
    }

    /// Validates core property content schema, type, and field bounds.
    function isValidPropertyContent(data) {
      return data.title is string
             && data.title.size() >= 3
             && data.title.size() <= 150
             && data.area is string
             && data.area.size() >= 2
             && data.area.size() <= 100
             && data.propertyType is string
             && data.propertyType.size() <= 50
             && data.division is string
             && data.division.size() <= 50
             && isPositiveWholeNumber(data.rentPerMonth)
             && data.rentPerMonth <= 5000000
             && (data.get('description', '') is string && data.get('description', '').size() <= 2000)
             && (data.get('fullAddress', '') is string && data.get('fullAddress', '').size() <= 300)
             && (data.get('landmark', '') is string && data.get('landmark', '').size() <= 150)
             && (data.get('depositAmount', null) == null || (isNonNegativeWholeNumber(data.depositAmount) && data.depositAmount <= 10000000))
             && (data.get('sizeSqFt', null) == null || (isPositiveWholeNumber(data.sizeSqFt) && data.sizeSqFt <= 50000))
             && (data.get('floorLevel', '') is string && data.get('floorLevel', '').size() <= 50)
             && (data.get('bedrooms', null) == null || (isNonNegativeWholeNumber(data.bedrooms) && data.bedrooms <= 50))
             && (data.get('bathrooms', null) == null || (isNonNegativeWholeNumber(data.bathrooms) && data.bathrooms <= 50))
             && (data.get('balconies', null) == null || (isNonNegativeWholeNumber(data.balconies) && data.balconies <= 50))
             && (data.get('facilities', []) is list && data.get('facilities', []).size() <= 30)
             && (data.get('nearbyHighlights', []) is list && data.get('nearbyHighlights', []).size() <= 20)
             && (data.get('availability', '') is string && data.get('availability', '').size() <= 50)
             && (data.get('availableNow', null) == null || data.availableNow is bool)
             && (data.get('preferredTenant', '') is string && data.get('preferredTenant', '').size() <= 50)
             && (data.get('utilityNotice', '') is string && data.get('utilityNotice', '').size() <= 300)
             && (data.get('photos', []) is list && data.get('photos', []).size() <= 10);
    }

    // -------------------------------------------------------------------------
    // 0. Admin Roster (/admins/{adminId})
    // Strictly read-only for authenticated clients; write operations are denied
    // to prevent any user self-elevation. Admins are managed only via Firebase Console.
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // 1. Users & Favourites
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && !('role' in request.resource.data)
                            && !('isAdmin' in request.resource.data)
                            && !('roles' in request.resource.data)
                            && !('isSuperuser' in request.resource.data)
                            && request.resource.data.keys().hasOnly([
                                 'displayName', 'name', 'email', 'phone',
                                 'photoUrl', 'favouritePropertyIds',
                                 'createdAt', 'updatedAt'
                               ]);
      allow delete: if isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // 2. Property Listings
    // -------------------------------------------------------------------------
    match /properties/{propertyId} {
      allow read: if resource.data.status == 'approved'
                  || (isAuthenticated() && (
                       resource.data.ownerId == request.auth.uid
                       || isAdmin()
                     ));

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.get('moderationNote', null) == null
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.keys().hasOnly([
                         'ownerId', 'status', 'moderationNote',
                         'createdAt', 'updatedAt', 'title', 'description',
                         'propertyType', 'division', 'area', 'fullAddress',
                         'landmark', 'rentPerMonth', 'depositAmount', 'sizeSqFt',
                         'floorLevel', 'bedrooms', 'bathrooms', 'balconies',
                         'facilities', 'availability', 'availableNow',
                         'preferredTenant', 'utilityNotice', 'nearbyHighlights',
                         'photos'
                       ])
                    && isValidPropertyContent(request.resource.data);

      allow update: if (
        // Branch A: Owner Content Update
        // Crucial security invariant: ANY edit to property content forces status
        // back to 'pending' and clears moderationNote, requiring re-moderation.
        (
          isOwner(resource.data.ownerId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.status == 'pending'
          && request.resource.data.get('moderationNote', null) == null
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'title', 'description', 'propertyType', 'division', 'area',
               'fullAddress', 'landmark', 'rentPerMonth', 'depositAmount',
               'sizeSqFt', 'floorLevel', 'bedrooms', 'bathrooms', 'balconies',
               'facilities', 'availability', 'availableNow', 'preferredTenant',
               'utilityNotice', 'nearbyHighlights', 'photos', 'status', 'moderationNote', 'updatedAt'
             ])
          && isValidPropertyContent(request.resource.data)
        )
        ||
        // Branch B: Authorized Admin Moderation
        // Admin can approve, reject, or request changes without altering property content.
        (
          isAdmin()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'moderationNote', 'updatedAt'
             ])
          && (request.resource.data.status in ['approved', 'rejected', 'pending'])
          && (request.resource.data.get('moderationNote', null) == null || (request.resource.data.moderationNote is string && request.resource.data.moderationNote.size() <= 500))
        )
      );

      allow delete: if isOwner(resource.data.ownerId);

      // -----------------------------------------------------------------------
      // Subcollection: Landlord Contact Info
      // Strictly isolated from public property document to protect private contact methods.
      // Accessible only by the owner or an authenticated tenant with an 'accepted' request.
      // -----------------------------------------------------------------------
      match /contact_info/{docId} {
        allow read: if isAuthenticated() && (
          (resource != null && resource.data.ownerId == request.auth.uid)
          ||
          (
            exists(/databases/$(database)/documents/rental_requests/$(propertyId + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/rental_requests/$(propertyId + '_' + request.auth.uid)).data.status == 'accepted'
          )
          ||
          (
            resource == null
            && exists(/databases/$(database)/documents/properties/$(propertyId))
            && get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid
          )
        );

        allow create: if isAuthenticated()
                      && request.resource.data.ownerId == request.auth.uid
                      && request.resource.data.propertyId == propertyId
                      && exists(/databases/$(database)/documents/properties/$(propertyId))
                      && get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time
                      && request.resource.data.keys().hasOnly([
                           'ownerId', 'propertyId', 'phone', 'whatsapp', 'email',
                           'otherTitle', 'otherLink', 'createdAt', 'updatedAt'
                         ])
                      && (request.resource.data.get('phone', null) == null || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
                      && (request.resource.data.get('whatsapp', null) == null || (request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 30))
                      && (request.resource.data.get('email', null) == null || (request.resource.data.email is string && request.resource.data.email.size() <= 100))
                      && (request.resource.data.get('otherTitle', null) == null || (request.resource.data.otherTitle is string && request.resource.data.otherTitle.size() <= 50))
                      && (request.resource.data.get('otherLink', null) == null || (request.resource.data.otherLink is string && request.resource.data.otherLink.size() <= 300));

        allow update: if isAuthenticated()
                      && resource.data.ownerId == request.auth.uid
                      && request.resource.data.ownerId == resource.data.ownerId
                      && request.resource.data.propertyId == propertyId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.updatedAt == request.time
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'phone', 'whatsapp', 'email', 'otherTitle', 'otherLink', 'updatedAt'
                         ])
                      && (request.resource.data.get('phone', null) == null || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
                      && (request.resource.data.get('whatsapp', null) == null || (request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 30))
                      && (request.resource.data.get('email', null) == null || (request.resource.data.email is string && request.resource.data.email.size() <= 100))
                      && (request.resource.data.get('otherTitle', null) == null || (request.resource.data.otherTitle is string && request.resource.data.otherTitle.size() <= 50))
                      && (request.resource.data.get('otherLink', null) == null || (request.resource.data.otherLink is string && request.resource.data.otherLink.size() <= 300));

        allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      }
    }

    // -------------------------------------------------------------------------
    // 3. Rental Requests
    // -------------------------------------------------------------------------
    match /rental_requests/{requestId} {
      // 1. Read: Requesting tenant or property owner can read
      // Safe null check prevents runtime evaluation error during transaction read-before-write or active checks
      allow read: if isAuthenticated() && (
        (resource != null && (
          resource.data.tenantId == request.auth.uid ||
          resource.data.ownerId == request.auth.uid
        ))
        ||
        (resource == null && requestId.matches('^.+_' + request.auth.uid + '$'))
      );

      // 2. Create: Authenticated tenant submits initial 'pending' request
      allow create: if isAuthenticated()
                    && request.resource.data.tenantId == request.auth.uid
                    && request.resource.data.ownerId is string
                    && request.resource.data.ownerId.size() > 0
                    && request.resource.data.tenantId != request.resource.data.ownerId
                    && request.resource.data.propertyId is string
                    && request.resource.data.propertyId.size() > 0
                    && requestId == request.resource.data.propertyId + '_' + request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.tenantName is string
                    && request.resource.data.tenantName.size() > 0
                    && request.resource.data.tenantPhone is string
                    && request.resource.data.tenantPhone.size() > 0
                    && request.resource.data.preferredMoveIn is string
                    && request.resource.data.preferredMoveIn.size() > 0
                    && request.resource.data.tenantEmail is string
                    && request.resource.data.message is string
                    && request.resource.data.propertyTitle is string
                    && request.resource.data.propertyTitle.size() > 0
                    && request.resource.data.propertyArea is string
                    && request.resource.data.propertyArea.size() > 0
                    && isPositiveWholeNumber(request.resource.data.rentPerMonth)
                    && (request.resource.data.get('propertyPhotoUrl', null) == null || request.resource.data.propertyPhotoUrl is string)
                    && request.resource.data.get('landlordNote', null) == null
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.keys().hasOnly([
                         'propertyId', 'ownerId', 'tenantId', 'tenantEmail',
                         'tenantName', 'tenantPhone', 'preferredMoveIn', 'message',
                         'propertyTitle', 'propertyArea', 'rentPerMonth', 'propertyPhotoUrl',
                         'status', 'landlordNote', 'createdAt', 'updatedAt'
                       ])
                    && exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId))
                    && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.status == 'approved'
                    && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.ownerId == request.resource.data.ownerId;

      // 3. Update: Strict role-based branching
      allow update: if isAuthenticated() && (
        // Branch A: Landlord Decision (Accept or Reject)
        (
          resource.data.ownerId == request.auth.uid
          && resource.data.status == 'pending'
          && (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected')
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.propertyId == resource.data.propertyId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'landlordNote', 'updatedAt'
             ])
          && (
               request.resource.data.get('landlordNote', null) == null ||
               request.resource.data.landlordNote is string
             )
        )
        ||
        // Branch B: Tenant Cancellation (Withdrawal)
        (
          resource.data.tenantId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.propertyId == resource.data.propertyId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'updatedAt'
             ])
          && request.resource.data.get('landlordNote', null) == resource.data.get('landlordNote', null)
        )
        ||
        // Branch C: Tenant Reapplication
        (
          resource.data.tenantId == request.auth.uid
          && (resource.data.status == 'cancelled' || resource.data.status == 'rejected')
          && request.resource.data.status == 'pending'
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.propertyId == resource.data.propertyId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.get('landlordNote', null) == null
          && request.resource.data.tenantName is string && request.resource.data.tenantName.size() > 0
          && request.resource.data.tenantPhone is string && request.resource.data.tenantPhone.size() > 0
          && request.resource.data.preferredMoveIn is string && request.resource.data.preferredMoveIn.size() > 0
          && request.resource.data.tenantEmail is string
          && request.resource.data.message is string
          && request.resource.data.propertyTitle is string && request.resource.data.propertyTitle.size() > 0
          && request.resource.data.propertyArea is string && request.resource.data.propertyArea.size() > 0
          && isPositiveWholeNumber(request.resource.data.rentPerMonth)
          && (request.resource.data.get('propertyPhotoUrl', null) == null || request.resource.data.propertyPhotoUrl is string)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'landlordNote', 'tenantName', 'tenantPhone',
               'tenantEmail', 'preferredMoveIn', 'message', 'updatedAt',
               'propertyTitle', 'propertyArea', 'rentPerMonth', 'propertyPhotoUrl'
             ])
          && exists(/databases/$(database)/documents/properties/$(resource.data.propertyId))
          && get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.status == 'approved'
          && get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.ownerId == resource.data.ownerId
        )
      );

      // 4. Delete: Denied for all users (preserves audit trail)
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 4. In-App Landlord-Tenant Conversations & Real-Time Messaging
    // -------------------------------------------------------------------------
    match /conversations/{conversationId} {
      // 1. Get: Single document fetch & pre-creation validation for accepted rental request
      allow get: if isAuthenticated() && (
        (
          resource != null && (
            resource.data.ownerId == request.auth.uid ||
            resource.data.tenantId == request.auth.uid
          )
        )
        ||
        (
          resource == null
          && exists(/databases/$(database)/documents/rental_requests/$(conversationId))
          && get(/databases/$(database)/documents/rental_requests/$(conversationId)).data.status == 'accepted'
          && (
            get(/databases/$(database)/documents/rental_requests/$(conversationId)).data.ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/rental_requests/$(conversationId)).data.tenantId == request.auth.uid
          )
        )
      );

      // 2. List: Collection queries strictly filtered by participant UID
      allow list: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid
      );

      // 2. Create: Either participant can initiate conversation for an accepted rental request
      allow create: if isAuthenticated()
                    && (request.auth.uid == request.resource.data.ownerId || request.auth.uid == request.resource.data.tenantId)
                    && request.resource.data.ownerId != request.resource.data.tenantId
                    && request.resource.data.propertyId is string
                    && request.resource.data.propertyId.size() > 0
                    && request.resource.data.requestId == request.resource.data.propertyId + '_' + request.resource.data.tenantId
                    && conversationId == request.resource.data.propertyId + '_' + request.resource.data.tenantId
                    && request.resource.data.propertyTitle is string
                    && request.resource.data.propertyTitle.size() > 0
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.keys().hasOnly([
                         'requestId', 'propertyId', 'propertyTitle', 'ownerId',
                         'tenantId', 'tenantName', 'lastMessageText', 'lastMessageSenderId',
                         'lastMessageAt', 'createdAt', 'updatedAt'
                       ])
                    && exists(/databases/$(database)/documents/rental_requests/$(request.resource.data.requestId))
                    && get(/databases/$(database)/documents/rental_requests/$(request.resource.data.requestId)).data.status == 'accepted'
                    && get(/databases/$(database)/documents/rental_requests/$(request.resource.data.requestId)).data.ownerId == request.resource.data.ownerId
                    && get(/databases/$(database)/documents/rental_requests/$(request.resource.data.requestId)).data.tenantId == request.resource.data.tenantId;

      // 3. Update: Participants can update lastMessage snippet and updatedAt while linked rental request is accepted
      allow update: if isAuthenticated()
                    && (resource.data.ownerId == request.auth.uid || resource.data.tenantId == request.auth.uid)
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.tenantId == resource.data.tenantId
                    && request.resource.data.propertyId == resource.data.propertyId
                    && request.resource.data.requestId == resource.data.requestId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'updatedAt'
                       ])
                    && request.resource.data.lastMessageSenderId == request.auth.uid
                    && (request.resource.data.lastMessageText is string && request.resource.data.lastMessageText.size() <= 2000)
                    && exists(/databases/$(database)/documents/rental_requests/$(resource.data.requestId))
                    && get(/databases/$(database)/documents/rental_requests/$(resource.data.requestId)).data.status == 'accepted'
                    && get(/databases/$(database)/documents/rental_requests/$(resource.data.requestId)).data.ownerId == resource.data.ownerId
                    && get(/databases/$(database)/documents/rental_requests/$(resource.data.requestId)).data.tenantId == resource.data.tenantId;

      // 4. Delete: Denied (preserves conversation audit log)
      allow delete: if false;

      // Messages Subcollection
      match /messages/{messageId} {
        // Read: Participant in parent conversation
        allow read: if isAuthenticated()
                    && exists(/databases/$(database)/documents/conversations/$(conversationId))
                    && (
                      get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId == request.auth.uid ||
                      get(/databases/$(database)/documents/conversations/$(conversationId)).data.tenantId == request.auth.uid
                    );

        // Create: Participant sends message; parent rental request must still be accepted
        allow create: if isAuthenticated()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.conversationId == conversationId
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.keys().hasOnly(['conversationId', 'senderId', 'text', 'createdAt'])
                      && exists(/databases/$(database)/documents/conversations/$(conversationId))
                      && (
                        get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId == request.auth.uid ||
                        get(/databases/$(database)/documents/conversations/$(conversationId)).data.tenantId == request.auth.uid
                      )
                      && exists(/databases/$(database)/documents/rental_requests/$(get(/databases/$(database)/documents/conversations/$(conversationId)).data.requestId))
                      && get(/databases/$(database)/documents/rental_requests/$(get(/databases/$(database)/documents/conversations/$(conversationId)).data.requestId)).data.status == 'accepted';

        // Update & Delete: Denied (messages are immutable)
        allow update, delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // 5. Media Cleanup Tasks (/media_cleanup_tasks/{taskId})
    // Created by property owner or admin when listings or photos are removed.
    // Processed and finalized exclusively by trusted server-side Cloud Functions.
    // -------------------------------------------------------------------------
    match /media_cleanup_tasks/{taskId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );

      allow create: if isAuthenticated()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.retryCount == 0
                    && request.resource.data.propertyId is string
                    && request.resource.data.propertyId.size() > 0
                    && request.resource.data.publicId is string
                    && request.resource.data.reason in ['property_deleted', 'photo_removed_during_edit']
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.keys().hasOnly([
                         'publicId', 'propertyId', 'ownerId', 'status',
                         'retryCount', 'reason', 'createdAt', 'updatedAt'
                       ])
                    && (
                      // Branch A: Property Owner creating cleanup for own property asset
                      // Strictly validates publicId structure matches 'properties/<ownerId>/<propertyId>/...'
                      (
                        request.resource.data.ownerId == request.auth.uid
                        && request.resource.data.publicId.matches('^properties/' + request.auth.uid + '/' + request.resource.data.propertyId + '/.+$')
                      )
                      ||
                      // Branch B: Verified Admin
                      (
                        isAdmin()
                        && request.resource.data.ownerId is string
                        && request.resource.data.publicId.matches('^properties/[^/]+/' + request.resource.data.propertyId + '/.+$')
                      )
                    );

      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // 6. Default Catch-All Deny
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
